# --- Stripe ----------------------------------------------------------------
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Webhook signing secret — start `stripe listen --forward-to localhost:3000/api/webhook/stripe`
# and copy the `whsec_…` value printed to your terminal.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# (Optional) Use real Stripe Prices instead of inline price_data
STRIPE_PRICE_DIGITAL=price_xxx
STRIPE_PRICE_PRINTS_4=price_xxx
STRIPE_PRICE_PRINTS_8=price_xxx

# --- Deployment ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional server-side AI fallbacks -------------------------------------
# Pick one and wire it up in /app/api/ai/* if you need higher accuracy than
# the client-side MediaPipe + imgly pipeline.
# REPLICATE_API_TOKEN=
# HUGGING_FACE_TOKEN=
# GOOGLE_APPLICATION_CREDENTIALS=
# AZURE_FACE_KEY=
# AZURE_FACE_ENDPOINT=
